# Copy to .env.local and fill in. Never commit .env.local.
# Full table of settings: docs/MVP_SPEC.md, section "Settings (environment variables)".

# Which engines run: DECIDER = local | llm | drex,  PERCEIVER = local | ndi
# local/local works as-is with no keys. Set DECIDER=llm once LLM_API_KEY is filled in.
DECIDER=local
PERCEIVER=local
REVIEW_THRESHOLD=0.6

# --- Nace (Drex + NDI) ---------------------------------------------------
# Tonight: point at the mock server (npm run mock-nace) with any nace_sk_ value.
# Tomorrow: change ONLY these two lines to the real address and key.
NACE_BASE_URL=http://localhost:4010
NACE_API_KEY=nace_sk_mock_000000000000000000000000000000000000000
#   NACE_BASE_URL=https://console.nace.ai
#   NACE_API_KEY=nace_sk_...your real key...
DREX_MODEL=drex-latest
DREX_PRICE_PER_MTOK=0.06
DREX_BATCH_SIZE=256
NDI_WAIT_SECONDS=60

# --- The "Giant" Drex is compared against (any OpenAI-compatible API) ---
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  (free tier: ~20 requests/model/day)
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  (one key, many models; reports cost itself)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_LABEL=Frontier LLM
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_TEMPERATURE=0
LLM_JSON_MODE=on

# --- Scoreboard: which runs the "size of the improvement" compares ---------
DREX_RUN=drex
BASELINE_RUN=
# (empty BASELINE_RUN = the first llm-* run in data/results)

# --- CORS ------------------------------------------------------------------
ALLOWED_ORIGIN=*
